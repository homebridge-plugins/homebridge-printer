{
  "name": "@homebridge-plugins/homebridge-printer",
  "alias": "Printer",
  "displayName": "Homebridge Printer",
  "type": "module",
  "version": "1.0.0",
  "description": "Homebridge plugin to show HP and other AirPrint (IPP) printers in Apple Home, with ink levels and a live dashboard.",
  "author": "homebridge-plugins",
  "license": "MIT",
  "homepage": "https://github.com/homebridge-plugins/homebridge-printer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge-plugins/homebridge-printer.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-printer/issues"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "supports-hap",
    "supports-matter",
    "homebridge-printer",
    "homekit",
    "printer",
    "ipp",
    "airprint",
    "hp",
    "ink",
    "energy"
  ],
  "main": "lib/index.js",
  "engines": {
    "homebridge": "^1.11.4 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "changelog:sync": "node .github/scripts/sync-changelog.mjs"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "homebridge": "^2.5.0",
    "vitest": "^5.1.0"
  }
}
